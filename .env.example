# ============================================================================
# AGILLIZA — variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie para .env.local (desenvolvimento) ou configure no VPS (produção).
# NUNCA versione .env.local. NUNCA coloque segredo em variável NEXT_PUBLIC_*:
# tudo com esse prefixo é embutido no JavaScript entregue ao navegador.
# ============================================================================

# --- Aplicação ---------------------------------------------------------------
NEXT_PUBLIC_URL_APP=http://localhost:3000
NODE_ENV=development

# --- Supabase: banco, autenticação e RLS ------------------------------------
# Pública: protegida por Row Level Security. Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_CHAVE_PUBLICA=

# SECRETA: ignora RLS por completo. Só no servidor, só em jobs e rotinas
# administrativas auditadas. Se esta chave vazar, todos os tenants vazam.
SUPABASE_CHAVE_SERVICO=

# Conexão direta (migrações e jobs). Use o pooler na porta 6543 para a
# aplicação e a 5432 apenas para migração.
DATABASE_URL=
DATABASE_URL_POOLER=

# --- Mídia: armazenamento próprio, fora do Supabase -------------------------
# Fotos, vídeos e tours de imóvel não ficam no Supabase Storage: o volume e a
# banda de saída de um portfólio imobiliário tornam isso caro e lento.
# Compatível com S3: MinIO no VPS, Cloudflare R2, Backblaze B2 ou AWS S3.
#
# SÃO DOIS ENDEREÇOS, E A DIFERENÇA NÃO É DETALHE DE REDE.
#
# A assinatura SigV4 inclui o `host` da requisição. Como o navegador envia a
# foto DIRETO para o armazenamento, a URL precisa ser assinada com o endereço
# que ELE alcança. Assinar com o nome do serviço interno (`minio:9000`) gera
# uma URL que só existe dentro do Docker, e o envio falha no navegador com um
# erro de rede que não menciona nada disso.
#
#   MIDIA_ENDPOINT          o que o NAVEGADOR alcança. Assina o envio.
#   MIDIA_ENDPOINT_INTERNO  o que o SERVIDOR usa para conferir e apagar.
#                           Em desenvolvimento, deixe vazio: cai no de cima.
MIDIA_ENDPOINT=http://localhost:9000
MIDIA_ENDPOINT_INTERNO=

MIDIA_REGIAO=us-east-1
MIDIA_BUCKET=agilliza-midia
MIDIA_CHAVE_ACESSO=
MIDIA_CHAVE_SECRETA=

# Onde as fotos PÚBLICAS são servidas (CDN ou domínio de mídia do VPS). Estas
# não são assinadas: o portfólio existe para ser aberto por qualquer um, e URL
# assinada quebraria o cache do navegador a cada visita.
MIDIA_URL_PUBLICA=http://localhost:9000/agilliza-midia

# `true` para MinIO (bucket no caminho), `false` para S3 (bucket no subdomínio).
MIDIA_FORCAR_PATH_STYLE=true

# --- Redis: cache, limite de requisições e filas ----------------------------
REDIS_URL=redis://localhost:6379
# Prefixo separa ambientes que compartilham a mesma instância.
REDIS_PREFIXO=agilliza:dev

# --- Segurança ---------------------------------------------------------------
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Criptografa credencial de integração do tenant antes de gravar no banco.
CHAVE_CRIPTOGRAFIA_SEGREDOS=
# Assina o token de sessão do portal do cliente (acesso por CPF + nascimento).
SEGREDO_SESSAO_PORTAL=

# --- Integrações externas (opcionais: ausentes = modo não configurado) -------
# SIMULAÇÃO DE FINANCIAMENTO — HOMEFIN
#
# As credenciais são DA PLATAFORMA, não de cada corretor: quem é parceiro
# cadastrado na Homefin é a Agilliza, e os corretores operam sob essa conta.
# Não existe BYOK aqui; o corretor nunca cadastra credencial de banco.
HOMEFIN_URL_BASE=https://api.homefin.com.br/external
HOMEFIN_CLIENTE_ID=
HOMEFIN_CLIENTE_SEGREDO=

# Ids fixos da conta Agilliza na Homefin.
#
# ATENÇÃO à regional: o POST /auth/token devolve idRegional = 1, que é a
# regional da PRÓPRIA HomeFin, não a nossa. Usar o valor do token faz a
# oportunidade nascer no lugar errado. A correta é 26 (AGILLIZA CRED).
HOMEFIN_ID_PARCEIRO=167
HOMEFIN_ID_REGIONAL=26
HOMEFIN_ID_USUARIO_PARCEIRO=159

# Análise de crédito
SERASA_URL_BASE=
SERASA_CLIENTE_ID=
SERASA_CLIENTE_SEGREDO=
SPC_URL_BASE=
SPC_USUARIO=
SPC_SENHA=

# Agenda
GOOGLE_CLIENTE_ID=
GOOGLE_CLIENTE_SEGREDO=

# Inteligência artificial
ANTHROPIC_API_KEY=

# --- Observabilidade ---------------------------------------------------------
NIVEL_LOG=info

# --- Implantação no VPS (usado por docker-compose.yml e pelo Caddyfile) ------
# O Caddy obtém e renova o certificado TLS destes dois domínios sozinho. Ambos
# precisam apontar para o IP do VPS ANTES de subir a pilha: o Let's Encrypt
# valida por DNS, e tentativa falha conta no limite de emissão.
#
# São domínios SEPARADOS de propósito. Foto enviada por corretor é conteúdo de
# terceiro; servi-la do mesmo domínio do sistema faria um arquivo malicioso
# rodar com acesso aos cookies de sessão.
DOMINIO=app.agilliza.com.br
DOMINIO_MIDIA=midia.agilliza.com.br

# O CONSOLE da plataforma. Aplicação separada, imagem separada, cookie separado.
# Quem entra nele vê todas as contas — por isso ele mora noutro domínio, e não
# numa rota do sistema do corretor.
DOMINIO_CONSOLE=console.agilliza.com.br

# Restringe o console a uma faixa de IP ou a uma VPN. VAZIO = responde na
# internet. Preencher é o desenho ideal para uma aplicação que enxerga os dados
# de todos os clientes. Formato do Caddy, separado por espaço:
#   CONSOLE_IPS_PERMITIDOS=203.0.113.0/24 198.51.100.7
CONSOLE_IPS_PERMITIDOS=

EMAIL_ADMIN=
